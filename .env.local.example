# Copy this file to .env.local and put your real Grok xAI key there.
# Never commit .env.local.

# Required: your xAI API key (https://console.x.ai)
XAI_API_KEY=put_your_grok_xai_key_here

# Chat / reasoning model used for streamed replies.
XAI_MODEL=grok-4.3

# Realtime speech-to-speech model for live calls.
# Options: grok-voice-latest, grok-voice-think-fast-1.0, grok-voice-fast-1.0
XAI_REALTIME_MODEL=grok-voice-latest

# Default Grok TTS voice: eve, ara, rex, sal, or leo.
XAI_VOICE=ara

# Optional: require this token on API requests if you expose the server beyond localhost.
# Leave blank for local development.
VM_API_TOKEN=
