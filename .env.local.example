# Copy this file to .env.local and put your real Grok xAI key there.
# Never commit .env.local.

# Required: your xAI API key (https://console.x.ai)
XAI_API_KEY=put_your_grok_xai_key_here

# Chat / reasoning model used for streamed replies.
# Lower cost options: grok-3-mini, grok-3-mini-fast (less capable but much cheaper).
XAI_MODEL=grok-4.3

# Realtime speech-to-speech model for live calls.
# Lower cost options (in order): grok-voice-fast-1.0, grok-voice-think-fast-1.0, grok-voice-latest
# Tip: grok-voice-fast-1.0 cuts realtime session cost significantly with minimal quality loss.
XAI_REALTIME_MODEL=grok-voice-latest

# Default Grok TTS voice: eve, ara, rex, sal, or leo.
XAI_VOICE=ara

# Optional: require this token on API requests if you expose the server beyond localhost.
# Leave blank for local development.
VM_API_TOKEN=

# ─── Cost-reduction flags ────────────────────────────────────────────────────

# Set to 1 to automatically describe each image upload with an LLM call.
# Off by default because it fires one extra chat completion per image uploaded.
VM_ENRICH_IMAGES=0

# Set to 1 to use the browser's built-in speech synthesis for all TTS.
# Eliminates every /api/grok/tts call. Voices sound less natural but cost nothing.
VM_BROWSER_TTS=0
